{
  "name": "@dsh-external/dsh-client-ui-skin-anime-wallpaper",
  "description": "Hot-pluggable anime-backdrop skin for the dsh web GUI: selectable wallpapers plus a theme-aware black/white overlay on the sidebar and conversation panes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "generate:backgrounds": "python scripts/generate-backgrounds.py"
  },
  "license": "CC-BY-NC-SA-4.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "lightningcss": "^1.32.0",
    "tsdown": "0.22.14"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
